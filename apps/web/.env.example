NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Optional Clerk OAuth for MCP. API keys work without this setting.
# Enable vows:read / vows:write custom scopes in Clerk and configure client registration.
# Set to the issuer advertised by Clerk's OAuth authorization-server metadata.
CLERK_OAUTH_ISSUER=
