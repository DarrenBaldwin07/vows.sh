	},
	"devDependencies": {
		"@repo/typescript-config": "workspace:*",
		"@types/node": "26.4.1",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"typescript": "7.0.2",
		"oxlint": "1.83.0",
		"tailwindcss": "4.3.3"
	},
	"dependencies": {
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.3.0",
		"lucide-react": "^1.47.0",
		"radix-ui": "^1.6.7",
		"shadcn": "^4.21.0",
		"tw-animate-css": "^1.4.0"
