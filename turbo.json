{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
		},
		"lint": {
			"dependsOn": ["^lint"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"dependsOn": ["^build"]
		}
	},
	"globalEnv": [
		"DATABASE_URL",
		"APP_URL",
		"CLERK_SECRET_KEY",
		"NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
		"SLACK_CLIENT_ID",
		"SLACK_CLIENT_SECRET",
		"INTEGRATION_ENCRYPTION_KEY"
	],
	"globalDependencies": [".env"]
}
