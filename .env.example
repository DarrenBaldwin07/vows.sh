# Local Docker Compose database only. Use your deployment's URL in production.
DATABASE_URL=postgresql://company:company_local@localhost:5433/company

# Canonical web origin. Use an HTTPS origin for Slack OAuth in production.
APP_URL=http://localhost:3100
# Slack app credentials; redirect URL: <APP_URL>/api/manage/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_ENCRYPTION_KEY=
# Clerk keys belong in apps/web/.env.local (see apps/web/.env.example).
