# Local Docker Compose database only. Use your deployment's URL in production.
DATABASE_URL=postgresql://company:company_local@localhost:5433/company

# Canonical web origin. Use an HTTPS origin for Slack OAuth in production.
APP_URL=http://localhost:3100
# Standalone API listens on port 3101 by default. Match the web app's Clerk instance.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional Clerk OAuth for agent/MCP clients.
CLERK_OAUTH_ISSUER=
# Slack app credentials; redirect URL: <APP_URL>/api/manage/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_ENCRYPTION_KEY=
# The web app also needs Clerk keys in apps/web/.env.local.
